<Window
    x:Class="REX.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="REX Tools"
    SizeChanged="OnSizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,8">
            <Button x:Name="ConnectButton" Click="OnConnectClick">Connect</Button>
            <Button x:Name="ColorButton" Click="OnColorClick">Set Color</Button>
            <Button x:Name="InstallButton" Click="OnInstallClick">Install Widget</Button>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="WidgetList" Margin="12,0"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding PackageId}" FontWeight="Bold" />
                        <TextBlock Text="{Binding State}" Foreground="Gray" />
                        <TextBlock Text="{Binding Width, StringFormat={}{0:0}x}" />
                        <TextBlock Text="{Binding Height}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" Text="REX Tools v0.1.0 — Phase 1"
                   HorizontalAlignment="Right" Margin="0,0,12,4" Opacity="0.3" FontSize="11" />
    </Grid>
</Window>
